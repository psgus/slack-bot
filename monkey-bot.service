[Unit]
Description=Monkey Slack Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/monkey-bot
ExecStart=/home/ubuntu/monkey-bot/.venv/bin/python -u /home/ubuntu/monkey-bot/monkey_bot.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
