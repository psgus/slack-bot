# Slack 앱 인증 정보
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=your-slack-channel-id

# Socket Mode
SLACK_APP_TOKEN=your-slack-app-level-token

# 서버
HOST=127.0.0.1
PORT=3000
TIMEZONE=Asia/Seoul
MENU_FILE=data/menu.json
ENABLE_SCHEDULER=true
SLACK_REPLY_IN_THREAD=false

# 외부 메뉴 게시글 동기화
KAKAO_CHANNEL_PROFILE_ID=example-profile-id
KAKAO_POSTS_API_URL_TEMPLATE=https://example.com/rocket-web/web/profiles/{profile_id}/posts?includePinnedPost=true
KAKAO_POSTS_PAGE_URL_TEMPLATE=https://example.com/{profile_id}/posts
KAKAO_REFERER_URL=https://example.com/
KAKAO_MENU_AUTO_SYNC=false
KAKAO_MENU_SYNC_INTERVAL_SECONDS=600
KAKAO_DAILY_MENU_AUTO_POST=false
KAKAO_DAILY_MENU_POST_INTERVAL_SECONDS=300
KAKAO_WEEKLY_MENU_AUTO_SYNC=false
KAKAO_WEEKLY_MENU_POST_URL=https://example.com/menu-post
KAKAO_WEEKLY_MENU_IMAGE_URL=
KAKAO_WEEKLY_MENU_SYNC_INTERVAL_SECONDS=300

# 선택: 주간 메뉴 이미지 OCR
OPENAI_MENU_VISION_ENABLED=false
OPENAI_MENU_VISION_MODEL=gpt-5.4-mini
OPENAI_MENU_VISION_REASONING_EFFORT=low

# 공지 권한
ANNOUNCE_ALLOWED_USER_IDS=

# 사다리 GIF 폰트
LADDER_FONT_PATH=

# 코칭룸 예약 연동
COACHING_ROOM_BASE_URL=https://example.com/coaching-room
COACHING_ROOM_NICKNAMES=스터디룸,회의방,프로젝트룸
COACHING_ROOM_RANDOM_NAME_USER_IDS=
COACHING_ROOM_CANCEL_PIN=
COACHING_ROOM_ALLOWED_USER_IDS=

# 세탁 현황
LAUNDRY_STATUS_URL=https://example.com/api/laundry/status

# 선택: OpenAI 잡담 응답
OPENAI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low
