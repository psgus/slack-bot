# Slack app credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789

# Socket Mode
SLACK_APP_TOKEN=xapp-your-app-level-token

# Server
PORT=3000
TIMEZONE=Asia/Seoul
MENU_FILE=data/menu.json
ENABLE_SCHEDULER=true
SLACK_REPLY_IN_THREAD=false

# Kakao menu sync and alerts
KAKAO_CHANNEL_PROFILE_ID=_xhzNjn
KAKAO_MENU_AUTO_SYNC=true
KAKAO_MENU_SYNC_INTERVAL_SECONDS=600
KAKAO_DAILY_MENU_AUTO_POST=true
KAKAO_DAILY_MENU_POST_INTERVAL_SECONDS=300
KAKAO_WEEKLY_MENU_AUTO_SYNC=true
KAKAO_WEEKLY_MENU_POST_URL=https://pf.kakao.com/_xhzNjn/112664323
KAKAO_WEEKLY_MENU_IMAGE_URL=
KAKAO_WEEKLY_MENU_SYNC_INTERVAL_SECONDS=300

# OpenAI vision for weekly menu images
OPENAI_MENU_VISION_ENABLED=true
OPENAI_MENU_VISION_MODEL=gpt-5.4-mini
OPENAI_MENU_VISION_REASONING_EFFORT=low

# Announcements and ladder
ANNOUNCE_ALLOWED_USER_IDS=
LADDER_FONT_PATH=

# Laundry status
LAUNDRY_STATUS_URL=

# Channel ambient conversation
CHANNEL_PASSIVE_CHAT_ENABLED=true
CHANNEL_PASSIVE_COOLDOWN_SECONDS=10
CHANNEL_PASSIVE_MIN_CHARS=4

# Coaching room reservations
COACHING_ROOM_BASE_URL=https://reservation-coachingroom.vercel.app
COACHING_ROOM_NICKNAMES=
COACHING_ROOM_RANDOM_NAME_USER_IDS=U0AL115FUR4
COACHING_ROOM_ALLOWED_USER_IDS=

# Optional OpenAI chat features
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
